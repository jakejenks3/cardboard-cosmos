extends SceneTree
## Writes ui/symbol_font_data.gd: the few symbols the game writes that Godot's
## own font lacks (arrows, triangles, a tick), as a small MSDF font (sharp at any
## size), packed into one picture. The PC draws these from the system's fonts; a
## phone's browser has none, so the web build adds this one as a fallback
## (SymbolFont.install()).
##
##   godot --headless --path . --script res://tools/make_symbol_font.gd -- <DroidSansFallback.ttf>
##
## The glyphs come from Droid Sans Fallback (Apache License 2.0, the Android Open
## Source Project; see ui/fonts/LICENSE-DroidSansFallback.txt). Only these glyphs'
## pictures and sizes are kept, not the font file.

const OUT = "res://ui/symbol_font_data.gd"
const MSDF_SIZE = 32
const PIXEL_RANGE = 8
const PAD = 2
## Each symbol, and the glyph it is drawn with (the source lacks a few small ones).
const CHARS = {
	"→": "→", "←": "←", "↑": "↑", "↓": "↓",
	"▲": "▲", "▼": "▼", "▾": "▼", "▴": "▲", "▸": "▶", "◂": "◀", "▶": "▶", "◀": "◀",
	"●": "●", "✓": "✓", "✔": "✓", "‧": "‧", "▪": "▪", "∙": "‧",
}


func _initialize() -> void:
	var args = OS.get_cmdline_user_args()
	if args.is_empty():
		print("usage: -- <path to DroidSansFallback.ttf>")
		quit(1)
		return
	var src = FontFile.new()
	if src.load_dynamic_font(args[0]) != OK:
		print("could not load ", args[0])
		quit(1)
		return
	src.multichannel_signed_distance_field = true
	src.msdf_size = MSDF_SIZE
	src.msdf_pixel_range = PIXEL_RANGE
	var sz = Vector2i(MSDF_SIZE, 0)
	var picked = []
	for ch in CHARS:
		var gi = src.get_glyph_index(MSDF_SIZE, str(CHARS[ch]).unicode_at(0), 0)
		if gi == 0:
			print("no glyph for ", CHARS[ch])
			continue
		src.render_glyph(0, sz, gi)
		picked.append([str(ch).unicode_at(0), gi])
	# Pack the glyphs' pictures side by side in one small image.
	var rows = []
	var x = PAD
	var h = 0
	for p in picked:
		var uv: Rect2 = src.get_glyph_uv_rect(0, sz, p[1])
		rows.append({"code": p[0], "gi": p[1], "uv": uv, "x": x})
		x += int(ceil(uv.size.x)) + PAD
		h = maxi(h, int(ceil(uv.size.y)))
	var atlas = Image.create(x, h + PAD * 2, false, Image.FORMAT_RGBA8)
	atlas.fill(Color(0, 0, 0, 0))
	var glyphs = {}
	for r in rows:
		var tex: Image = src.get_texture_image(0, sz, src.get_glyph_texture_idx(0, sz, r.gi))
		if tex.get_format() != Image.FORMAT_RGBA8:
			tex.convert(Image.FORMAT_RGBA8)
		var uv: Rect2 = r.uv
		var region = Rect2i(int(uv.position.x), int(uv.position.y), int(ceil(uv.size.x)), int(ceil(uv.size.y)))
		atlas.blit_rect(tex, region, Vector2i(int(r.x), PAD))
		var adv = src.get_glyph_advance(0, MSDF_SIZE, r.gi)
		var off = src.get_glyph_offset(0, sz, r.gi)
		var gs = src.get_glyph_size(0, sz, r.gi)
		glyphs[int(r.code)] = [snappedf(adv.x, 0.001), snappedf(off.x, 0.001), snappedf(off.y, 0.001), snappedf(gs.x, 0.001), snappedf(gs.y, 0.001),
			float(r.x) + (uv.position.x - float(region.position.x)), float(PAD) + (uv.position.y - float(region.position.y)), snappedf(uv.size.x, 0.001), snappedf(uv.size.y, 0.001)]
	var png = atlas.save_png_to_buffer()
	var lines = [
		"class_name SymbolFontData",
		"extends RefCounted",
		"## Generated by tools/make_symbol_font.gd: do not edit. The symbols Godot's own",
		"## font lacks, as MSDF glyphs (from Droid Sans Fallback, Apache License 2.0,",
		"## the Android Open Source Project: ui/fonts/LICENSE-DroidSansFallback.txt).",
		"## GLYPHS: {char code: [advance, offset x, offset y, width, height, uv x, uv y, uv w, uv h]}",
		"",
		"const MSDF_SIZE = %d" % MSDF_SIZE,
		"const PIXEL_RANGE = %d" % PIXEL_RANGE,
		"const ASCENT = %s" % str(snappedf(src.get_cache_ascent(0, MSDF_SIZE), 0.001)),
		"const DESCENT = %s" % str(snappedf(src.get_cache_descent(0, MSDF_SIZE), 0.001)),
		"const UNDERLINE = %s" % str(snappedf(src.get_cache_underline_position(0, MSDF_SIZE), 0.001)),
		"const UNDERLINE_W = %s" % str(snappedf(src.get_cache_underline_thickness(0, MSDF_SIZE), 0.001)),
		"const GLYPHS = %s" % JSON.stringify(glyphs).replace("\"", ""),
		"const PNG = \"%s\"" % Marshalls.raw_to_base64(png),
		"",
	]
	var f = FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string("\n".join(PackedStringArray(lines)))
	f.close()
	print("symbols: %d glyphs, atlas %dx%d, png %d bytes -> %s" % [glyphs.size(), atlas.get_width(), atlas.get_height(), png.size(), OUT])
	quit(0)
