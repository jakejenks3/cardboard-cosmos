class_name Icons
extends RefCounted
## The pixel-art icon set. The game shows no emoji (they do not render
## reliably in Godot): every picture is one of these 16×16 icons, and every
## emoji found in game data is mapped to one with `for_emoji`.
##
## Each icon is 16 rows of 16 characters plus a palette: "." is transparent,
## "o" is the dark outline, every other letter is a colour from its palette.

const SIZE = 16
const OUTLINE = Color("1a1026")

static var _cache = {}


## Every icon name.
static func names() -> Array:
	return DATA.keys()


static func has_icon(icon) -> bool:
	return icon is String and DATA.has(icon)


## The icon as a texture (cached). An unknown name gives the star.
## With `tint` (a Color) the icon is recoloured to shades of that colour.
static func tex(icon: String, tint = null) -> ImageTexture:
	var key = icon
	if tint != null:
		key = icon + "|" + tint.to_html()
	if _cache.has(key):
		return _cache[key]
	var d = DATA.get(icon, DATA["star"])
	var pal = {}
	var max_l = 0.001
	for ch in d.pal:
		var c = Color.html(d.pal[ch])
		pal[ch] = c
		max_l = maxf(max_l, c.get_luminance())
	var img = Image.create_empty(SIZE, SIZE, false, Image.FORMAT_RGBA8)
	for y in range(SIZE):
		var row = d.rows[y]
		for x in range(SIZE):
			var ch = row[x]
			if ch == ".":
				continue
			var c = OUTLINE
			if ch != "o":
				c = pal[ch]
				if tint != null:
					# Keep the icon's light and shade, in the tint's colour.
					var k = c.get_luminance() / max_l
					c = Color(tint.r, tint.g, tint.b).darkened(0.45 * (1.0 - k))
			img.set_pixel(x, y, c)
	var t = ImageTexture.create_from_image(img)
	_cache[key] = t
	return t


## A crisp TextureRect showing the icon at `px` × `px`.
static func rect(icon: String, px: float = 20.0, tint = null) -> TextureRect:
	var r = TextureRect.new()
	r.texture = tex(icon, tint)
	r.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	r.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	r.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	r.custom_minimum_size = Vector2(px, px)
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	r.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	r.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	return r


## The icon to show for an emoji from the game data ("star" when unknown).
static func for_emoji(emoji) -> String:
	if not (emoji is String) or emoji == "":
		return "star"
	if DATA.has(emoji):
		return emoji
	return EMOJI.get(emoji.unicode_at(0), "star")


static func _is_emoji(cp: int) -> bool:
	if cp == 0x200D or cp == 0xFE0F or cp == 0xFE0E or cp == 0x20E3:
		return true
	if cp >= 0x1F000 and cp <= 0x1FAFF:
		return true
	if cp >= 0x2600 and cp <= 0x27BF:
		# Keep the plain check marks and crosses, which read fine as text.
		return not (cp >= 0x2713 and cp <= 0x2717)
	if cp >= 0x2300 and cp <= 0x23FF:
		return true
	if cp >= 0x2B00 and cp <= 0x2BFF:
		return true
	if cp >= 0xE0020 and cp <= 0xE007F:
		return true
	return false


## `text` without emoji / pictographs, with the leftover spacing tidied.
static func strip_emoji(text) -> String:
	var s = str(text)
	var out = ""
	for i in range(s.length()):
		var cp = s.unicode_at(i)
		if not _is_emoji(cp):
			out += s[i]
	while out.contains("  "):
		out = out.replace("  ", " ")
	return out.strip_edges()

