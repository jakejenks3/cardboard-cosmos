# Copy to .env and fill in from https://www.strava.com/settings/api
# Set the app's "Authorization Callback Domain" to the host you run this on
# (e.g. localhost for development, or your deployed domain).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Where the browser should be sent back to after Strava authorizes.
# Development (Vite dev server): http://localhost:5173
# Production (server serves the built app): https://your-domain.example
APP_URL=http://localhost:5173

# Port for the API/static server.
PORT=8787

# Optional but strongly recommended when this server is reachable by anyone
# other than you: require a password before it serves your data and progress
# photos. The app asks for it once (Settings → Server) and remembers a cookie.
APP_PASSWORD=

# Optional: where the server keeps state.json, strava.json and photos/.
# DATA_DIR=/var/lib/tiny-titan

# Who can reach the server. By default it listens on this computer only when
# APP_URL is a localhost address, and on all interfaces otherwise (a host
# needs that). Set HOST=0.0.0.0 to force all interfaces, e.g. to open the app
# from your phone on the same Wi-Fi — and set APP_PASSWORD if you do.
# HOST=127.0.0.1
